{
  "manifest_version": 3,
  "name": "fastp.ge",
  "description": "Pretty, fast share links for public Notion pages. Copy a short fastp.ge link with one shortcut.",
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "Copy pretty fastp.ge link",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "copy-pretty": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "MacCtrl+Shift+L" },
      "description": "Copy pretty link"
    },
    "copy-fast": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "MacCtrl+Shift+F" },
      "description": "Copy fast link"
    }
  }
}

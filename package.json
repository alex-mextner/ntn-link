{
  "name": "ntn-link",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "extension"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "build:extension": "bun run --cwd extension build",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:redis": "bun run packages/core/scripts/test-redis.ts",
    "test:postgres": "bun run packages/core/scripts/test-postgres.ts",
    "test:neon": "bun test packages/core/test/neon.integration.test.ts",
    "smoke:notion": "bun run packages/core/scripts/smoke-notion.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
